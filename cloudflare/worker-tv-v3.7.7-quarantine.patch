+const QUARANTINE_URL = 'https://raw.githubusercontent.com/annalisazotti11/tv-italia-puglia/refs/heads/main/data/source-quarantine.json';
+const SAFE_C5_ENDPOINT = 'https://tv-italia-puglia.annalisazotti11.workers.dev/stream/tv/tvip_5_canale-5-hd.json';
+let quarantineMemo = {until:0,value:null,pending:null};
+let c5Memo = {until:0,value:null,pending:null};
+async function legacyQuarantine(){
+  if(quarantineMemo.until>Date.now())return quarantineMemo.value;
+  if(quarantineMemo.pending)return quarantineMemo.pending;
+  quarantineMemo.pending=(async()=>{
+    try{
+      const r=await fetch(QUARANTINE_URL,{redirect:'manual',signal:AbortSignal.timeout(3500)});
+      if(!r.ok)throw Error('Policy unavailable');
+      const p=await r.json();
+      if(p.schema!==1||!Array.isArray(p.blocked_hosts)||!p.approved_only||!p.blocked_by_channel||
+        !Array.isArray(p.approved_only['tvip_5_canale-5-hd']))throw Error('Invalid policy');
+      quarantineMemo.value=p;
+    }catch{quarantineMemo.value=null;}
+    quarantineMemo.until=Date.now()+60000;
+    return quarantineMemo.value;
+  })();
+  try{return await quarantineMemo.pending;}finally{quarantineMemo.pending=null;}
+}
+function legacyIdentityAllowed(p,id,url){
+  if(!p||typeof url!=='string')return false;
+  try{
+    const u=new URL(url),host=u.hostname.toLowerCase().replace(/\.$/,'');
+    if(u.protocol!=='https:'||u.username||u.password||u.hash||p.blocked_hosts.includes(host))return false;
+    if(Object.hasOwn(p.approved_only,id)&&!p.approved_only[id].includes(url))return false;
+    return !(p.blocked_by_channel[id]||[]).includes(url);
+  }catch{return false;}
+}
